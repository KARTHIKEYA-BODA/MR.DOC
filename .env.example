# Add keys for the providers you use, then save this file as .env.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Puck
ANTHROPIC_API_KEY=
CARELY_MODEL=claude-sonnet-5-5
PORT=8000
HOST=127.0.0.1

# Account database defaults to the current user's private app-data directory.
# Override only when you have a protected persistent volume.
# MRDOC_AUTH_DB=
# MRDOC_DATA_KEY_FILE=
# Set to true when served over HTTPS in production; leave unset for localhost HTTP.
# AUTH_COOKIE_SECURE=true

# Password reset email delivery (SMTP). Required for reset links to be sent.
# Use a provider-issued app password or SMTP credential, never your normal mailbox password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false
# Use your real HTTPS app URL when deployed. Local development defaults to localhost:8000.
MRDOC_PUBLIC_URL=http://localhost:8000

# Optional independent OCR reader. Leave URL empty to keep Gemini-only uploads.
# Start the GPU service first; see docs/unlimited-ocr.md. Do not use the app's port.
UNLIMITED_OCR_URL=
UNLIMITED_OCR_MODEL=baidu/Unlimited-OCR
UNLIMITED_OCR_API_KEY=
UNLIMITED_OCR_TIMEOUT_SECONDS=25
UNLIMITED_OCR_MAX_PDF_PAGES=8
